{
  "expo": {
    "name": "Traffiq",
    "slug": "traffiq",
    "scheme": "traffiq",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/traffiq-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/traffiq-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090b0a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Traffiq uses your location while the app is open to show your position and current speed on the expanded map."
      }
    },
    "android": {
      "package": "com.traffiq.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/traffiq-adaptive-icon.png",
        "backgroundColor": "#090b0a"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a374c63f-97b0-43d9-97c1-deda33163a29"
      }
    }
  }
}
